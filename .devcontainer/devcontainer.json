{
	"name": "NetBox plugin (Python 3 & PostgreSQL)",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspaces/netbox",

	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/devcontainers/features/node:1": {},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
	},

	// Make NetBox (runserver 0.0.0.0:8000) reachable from the Mac.
	"forwardPorts": [8000],
	"portsAttributes": {
		"8000": { "label": "NetBox", "onAutoForward": "notify" }
	},

	// The ~/.claude volume is created owned by root: give it to vscode so Claude Code can write its files.
	// Then install the dependencies of database_init.py (psycopg).
	"postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.claude && pip install --user -r requirements.txt",

	// psql / pg_dump / pg_restore work without flags (README uses --host=db).
	"remoteEnv": {
		"PGHOST": "db",
		"PGUSER": "${containerEnv:POSTGRES_USER}",
		"PGPASSWORD": "${containerEnv:POSTGRES_PASSWORD}"
	},

	// Keep the Claude Code login/config across container rebuilds.
	"mounts": [
		"source=netbox-dev-claude-config,target=/home/vscode/.claude,type=volume"
	],

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.debugpy",
				"charliermarsh.ruff",
				"batisteo.vscode-django",
				"redhat.vscode-yaml"
			],
			"settings": {
				// The venv is created later by netbox/upgrade.sh. Until then VS Code falls back to the
				// system Python; after upgrade.sh, run "Developer: Reload Window" to pick up the venv.
				"python.defaultInterpreterPath": "${containerWorkspaceFolder}/netbox/venv/bin/python",
				"python.terminal.activateEnvironment": true,
				"[python]": {
					"editor.defaultFormatter": "charliermarsh.ruff",
					"editor.formatOnSave": true,
					"editor.codeActionsOnSave": { "source.fixAll.ruff": "explicit" }
				},
				"files.associations": { "**/templates/**/*.html": "django-html" },
				// Keep the virtualenvs and build output out of the file watcher, search and indexing:
				// they hold tens of thousands of files, read through the slow bind mount.
				"files.watcherExclude": {
					"**/venv/**": true,
					"**/.venv/**": true,
					"**/node_modules/**": true,
					"**/build/**": true,
					"**/*.egg-info/**": true,
					"**/__pycache__/**": true,
					"**/.ruff_cache/**": true,
					"**/.git/objects/**": true
				},
				"search.exclude": {
					"**/venv": true,
					"**/.venv": true,
					"**/node_modules": true,
					"**/build": true,
					"**/*.egg-info": true,
					"**/__pycache__": true,
					"**/netbox-demo-*.sql": true
				},
				"python.analysis.exclude": [
					"**/venv",
					"**/.venv",
					"**/node_modules",
					"**/build",
					"**/__pycache__"
				]
			}
		}
	}
}
