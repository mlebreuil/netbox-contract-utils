# Copy this file to .env and fill in the values. .env is ignored by git: never commit it.

# PostgreSQL superuser (used by the db service and by database_init.py)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# NetBox database, created by database_init.py
NETBOX_DB_NAME=netbox
NETBOX_DB_USER=netbox
NETBOX_DB_PASSWORD=

# Optional: PostgreSQL major version (default 17). Must match an existing postgres-data volume.
# POSTGRES_VERSION=17

# NetBox secrets: any random alphanumeric string of 50+ characters, one per variable. Generate with:
#   python3 -c "import secrets, string; print(''.join(secrets.choice(string.ascii_letters + string.digits) for _ in range(64)))"
# They are read by netbox-configuration-4.7*.py.
NETBOX_SECRET_KEY=
NETBOX_API_TOKEN_PEPPER=
